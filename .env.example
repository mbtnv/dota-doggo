# bot/worker require BOT_TOKEN. migrate, healthcheck and import-legacy do not.
BOT_TOKEN=
DATABASE_URL=postgres://postgres:local-test-only@localhost:55439/dota_doggo_test?sslmode=disable
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
POLL_INTERVAL_MINUTES=15
DEFAULT_TIMEZONE=UTC
ALLOWED_TELEGRAM_USER_IDS=
TELEGRAM_ADMIN_CHECK_ENABLED=true
TELEGRAM_PROXY_URL=
# Override only for a self-hosted Bot API or local test server.
TELEGRAM_BASE_URL=https://api.telegram.org
# Optional loopback readiness endpoint. Use different ports for host bot/worker.
# Containers configure this automatically; no ports need to be published.
HEALTH_ADDR=
OPENDOTA_MAX_RETRIES=3
TELEGRAM_SEND_MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1
CONSTANTS_SYNC_INTERVAL_HOURS=24
LOG_LEVEL=INFO
DB_MAX_CONNS=5
# worker requires DB_MAX_CONNS >= 2; one connection holds its advisory lock.

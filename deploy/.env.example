# Copy to /opt/dota-doggo/.env on the VPS, chmod 600. Never commit the real file.
BOT_TOKEN=
# Generate with: openssl rand -hex 32 (URL-safe; do not change on an existing volume).
POSTGRES_PASSWORD=
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
TELEGRAM_BASE_URL=https://api.telegram.org
TELEGRAM_PROXY_URL=
POLL_INTERVAL_MINUTES=15
DEFAULT_TIMEZONE=UTC
ALLOWED_TELEGRAM_USER_IDS=
TELEGRAM_ADMIN_CHECK_ENABLED=true
OPENDOTA_MAX_RETRIES=3
TELEGRAM_SEND_MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1
CONSTANTS_SYNC_INTERVAL_HOURS=24
DB_MAX_CONNS=5
LOG_LEVEL=INFO
